# foundry build output
out/
cache/
broadcast/

# python bytecode from tools/
__pycache__/

# secrets — never committed
.env
*.env

# Generated backfill input. The real list is emitted on the execution day from the
# authoritative data directory and its sha256 is recorded then; committing an earlier
# copy would be a stale input wearing the same name.
backfill-list.jsonl

# Generated by tools/check_backfill_list.py --emit; a committed copy would be a stale record.
backfill-checked.json
